[run]
source = .
parallel = true
concurrency = multiprocessing
data_file = .coverage
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */virtualenv/*
    manage.py
    config/wsgi.py
    config/asgi.py
    */.venv/*
    */node_modules/*
    */staticfiles/*
    */files/*
    */admin.py
    */management/commands/seed_knowledge_base.py
    */management/commands/fix_user_sequence.py
    */management/commands/migrate_caretaker_data.py
    */management/commands/verify_caretaker_migration.py
    */management/commands/audit_media_files.py
    */management/commands/cleanup_old_drafts.py
    config/color_formatter.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
