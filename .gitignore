# Root-level gitignore for monorepo
# Specific ignores are in frontend/.gitignore and backend/.gitignore
uat_creds.yaml
prod_creds.yaml

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
.cache/

# Build artifacts (covered by subdirectory gitignores, but listed for clarity)
dist/
build/
*.pyc
__pycache__/
node_modules/

# Coverage reports (covered by subdirectory gitignores)
coverage/
htmlcov/
.coverage
*.cover

# Docker
.docker/
docker-compose.override.yml

# Backup files
*.bak
*.backup

# Media directories (should never be in Git)
dumped_media/
/media/
uploads/
backend/media/

# Build artifacts (generated files)
staticfiles/

# Raw data (source files, not generated)
public/data/raw/

# Large binary files
*.pdf
*.zip
*.tar.gz
*.sql
*.dump

# Coverage files (generated)
coverage.json
**/coverage.json
backend/templates/admin/medias/projectphoto/change_list.html
backend/templates/admin/medias/useravatar/change_list.html
backend/medias/management/commands/audit_media_files.py

# Generated email preview files (created by email testing endpoints)
backend/test_email_preview.html
backend/test_email_preview.eml
backend/email_previews/

# Editor uploaded images (served from media, not committed)
backend/files/editor/
